# DeepSeek API 配置
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通知推送配置（留空则不推送，后续填写即生效）
# 企业微信群机器人 Webhook 地址
WECOM_WEBHOOK_URL=

# 数据查看界面访问口令（留空时拒绝访问；请设置强随机值）
ADMIN_TOKEN=

# 邮件通知（SMTP 服务商 + 授权码 + 收件顾问邮箱，多个用英文逗号分隔）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=

# Docker Compose 部署时使用：填写实际已配置 DNS 的子域名，不含 https://
EVALUATION_DOMAIN=

# 单实例接口限流（同一来源在窗口内的请求次数；0 表示关闭对应接口限流）
RATE_LIMIT_WINDOW_SECONDS=600
EVALUATE_RATE_LIMIT=10
LEAD_RATE_LIMIT=20
