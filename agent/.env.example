# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通知推送配置（留空则不推送，后续填写即生效）
# 企业微信群机器人 Webhook 地址
WECOM_WEBHOOK_URL=

# 数据查看界面访问口令（公网部署必须设置为强随机值）
ADMIN_TOKEN=

# 邮件通知（SMTP 服务商 + 授权码 + 收件顾问邮箱，多个用英文逗号分隔）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
